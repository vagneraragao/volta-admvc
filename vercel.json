{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/telao",
      "destination": "/index.html"
    },
    {
      "source": "/obra",
      "destination": "/index.html"
    },
    {
      "source": "/construcao",
      "destination": "/index.html"
    },
    {
      "source": "/carnes",
      "destination": "/index.html"
    },
    {
      "source": "/cofrinhos",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
